# Server Port (Render/Railway sets PORT automatically)
PORT=5000
NODE_ENV=production

# PostgreSQL Connection (Use DATABASE_URL or individual variables)
# Example Cloud URL: postgresql://username:password@host:5432/Smartcanteen?sslmode=require
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/Smartcanteen

# Optional Individual DB Variables (Fallback if DATABASE_URL is omitted)
# PGUSER=postgres
# PGPASSWORD=your_password
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=Smartcanteen
# DB_SSL=false

# Allowed Frontend URLs for CORS
STUDENT_APP_URL=https://your-student-app.vercel.app
ADMIN_APP_URL=https://your-admin-app.vercel.app
